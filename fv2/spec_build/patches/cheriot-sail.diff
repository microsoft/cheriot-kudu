     NOT_C_CAPMODE(_) => encdec_compressed(bv),
     C_CAPMODE_AST => C_CAPMODE_AST
-  }
+  };
+  if rv32e_illegal(a) then C_ILLEGAL(bv) else a
 }
 
 function ext_decode(bv : bits(32)) -> ast = {
-  match(encdec_capmode(bv)) {
+  let a : ast = match(encdec_capmode(bv)) {
