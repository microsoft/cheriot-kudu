+    CSpecialRW(cd, _, cs1)         => e16(cs1) | e16(cd),
+    CAndPerm(cd, cs1, rs2)         => e16(cs1) | e16(rs2) | e16(cd),
+    CSub(rd, cs1, cs2)             => e16(cs1) | e16(cs2) | e16(rd),
