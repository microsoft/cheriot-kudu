+    CIncAddrImmediate(cd, cs1, _)  => e16(cs1) | e16(cd),
+    CSetAddr(cd, cs1, rs2)         => e16(cs1) | e16(rs2) | e16(cd),
+    CSetBounds(cd, cs1, rs2)       => e16(cs1) | e16(rs2) | e16(cd),
+    CSetBoundsImmediate(cd, cs1, _) => e16(cs1) | e16(cd),
+    CSetBoundsExact(cd, cs1, rs2)  => e16(cs1) | e16(rs2) | e16(cd),
+    CSetBoundsRoundDown(cd, cs1, rs2) => e16(cs1) | e16(rs2) | e16(cd),
+    CClearTag(cd, cs1)             => e16(cs1) | e16(cd),
+    CMove(cd, cs1)                 => e16(cs1) | e16(cd),
