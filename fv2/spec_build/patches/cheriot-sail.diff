+    CTestSubset(rd, cs1, cs2)      => e16(cs1) | e16(cs2) | e16(rd),
+    CSEQX(rd, cs1, cs2)            => e16(cs1) | e16(cs2) | e16(rd),
+    CSeal(cd, cs1, cs2)            => e16(cs1) | e16(cs2) | e16(cd),
+    CUnseal(cd, cs1, cs2)          => e16(cs1) | e16(cs2) | e16(cd),
+    LoadCapImm(cd, cs1, _)         => e16(cs1) | e16(cd),
+    StoreCapImm(cs2, cs1, _)       => e16(cs1) | e16(cs2),
+    /* compressed: only the full 5-bit register fields can name x16-x31 */
+    C_ADDI(_, rsd)                 => e16(rsd),
+    C_LI(_, rd)                    => e16(rd),
+    C_LUI(_, rd)                   => e16(rd),
+    C_SLLI(_, rsd)                 => e16(rsd),
+    C_LWSP(_, rd)                  => e16(rd),
+    C_SWSP(_, rs2)                 => e16(rs2),
+    C_JR(rs1)                      => e16(rs1),
+    C_JALR(rs1)                    => e16(rs1),
+    C_MV(rd, rs2)                  => e16(rd) | e16(rs2),
+    C_ADD(rsd, rs2)                => e16(rsd) | e16(rs2),
+    C_CLCSP(cd, _)                 => e16(cd),
+    C_CSCSP(cs2, _)                => e16(cs2),
+    C_CJALR(cs1)                   => e16(cs1),
+    C_CJR(cs1)                     => e16(cs1),
+    /* compressed hints (C_ADDI_HINT, C_MV_HINT, C_ADD_HINT, C_SLLI_HINT, ...)
+     * are never illegal: Kudu's compressed decoder zeroes their register
+     * fields (NOP / add x0,x0,x0 / slli x0,x0,sh), so no x16-x31 is used */
+    _                              => false
+  }
+}
