+    RISCV_JALR(_, rs1, rd)         => e16(rs1) | e16(rd),
+    BTYPE(_, rs2, rs1, _)          => e16(rs1) | e16(rs2),
+    ITYPE(_, rs1, rd, _)           => e16(rs1) | e16(rd),
+    SHIFTIOP(_, rs1, rd, _)        => e16(rs1) | e16(rd),
+    RTYPE(rs2, rs1, rd, _)         => e16(rs1) | e16(rs2) | e16(rd),
+    LOAD(_, rs1, rd, _, _, _, _)   => e16(rs1) | e16(rd),
+    STORE(_, rs2, rs1, _, _, _)    => e16(rs1) | e16(rs2),
+    MUL(rs2, rs1, rd, _)           => e16(rs1) | e16(rs2) | e16(rd),
+    DIV(rs2, rs1, rd, _)           => e16(rs1) | e16(rs2) | e16(rd),
+    REM(rs2, rs1, rd, _)           => e16(rs1) | e16(rs2) | e16(rd),
+    CSR(_, rs1, rd, is_imm, _)     => (not(is_imm) & e16(rs1)) | e16(rd),
