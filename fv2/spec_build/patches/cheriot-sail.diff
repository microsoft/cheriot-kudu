+    CGetPerm(rd, cs1)              => e16(cs1) | e16(rd),
+    CGetType(rd, cs1)              => e16(cs1) | e16(rd),
+    CGetBase(rd, cs1)              => e16(cs1) | e16(rd),
+    CGetHigh(rd, cs1)              => e16(cs1) | e16(rd),
+    CGetTop(rd, cs1)               => e16(cs1) | e16(rd),
+    CGetLen(rd, cs1)               => e16(cs1) | e16(rd),
+    CGetTag(rd, cs1)               => e16(cs1) | e16(rd),
+    CGetAddr(rd, cs1)              => e16(cs1) | e16(rd),
