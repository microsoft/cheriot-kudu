+    RISCV_CTZ(rs1, rd)             => e16(rs1) | e16(rd),
+    RISCV_CLMUL(rs2, rs1, rd)      => e16(rs1) | e16(rs2) | e16(rd),
+    RISCV_CLMULH(rs2, rs1, rd)     => e16(rs1) | e16(rs2) | e16(rd),
+    RISCV_CLMULR(rs2, rs1, rd)     => e16(rs1) | e16(rs2) | e16(rd),
+    ZBS_IOP(_, rs1, rd, _)         => e16(rs1) | e16(rd),
