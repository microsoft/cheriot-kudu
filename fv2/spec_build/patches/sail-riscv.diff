diff --git a/model/riscv_insts_aext.sail b/model/riscv_insts_aext.sail
new file mode 100644
index 0000000..5fe1f20
--- /dev/null
+++ b/model/riscv_insts_aext.sail
@@ -0,0 +1,162 @@
+/*=======================================================================================*/
+/*  This Sail RISC-V architecture model, comprising all files and                        */
+/*  directories except where otherwise noted is subject the BSD                          */
+/*  two-clause license in the LICENSE file.                                              */
+/*                                                                                       */
+/*  SPDX-License-Identifier: BSD-2-Clause                                                */
+/*=======================================================================================*/
+
+/*
+ * kudu-fv: the A extension (LR.W, SC.W, AMO*.W), ported from sail-riscv
+ * 122bcb8 model/riscv_insts_aext.sail to the FV memory interface (the
+ * b0589c3 LOAD/STORE style: ext_data_get_addr with a byte width, no
+ * translateAddr or EA calls, MemException(addr, e)).  CHERIoT authority is
+ * the capability in cs1, checked by cheriot-sail's ext_data_get_addr
+ * (tag, seal, LD for LR, SD for SC, LD and SD for AMOs, bounds of 4 bytes).
+ * Upstream cheriot-sail does not compile this file.
+ *
+ * The reservation is held by the memory system, not by the core: the SC
+ * outcome is match_reservation(), which the SV build turns into an input
+ * port (-sv-fun2wires match_reservation); load_reservation and
+ * cancel_reservation are no-ops.  RV32 only, so only WORD is valid.
+ */
+
+function amo_width_valid(size : word_width) -> bool = {
+  match(size) {
+    WORD   => true,
+    _      => false
+  }
+}
+
+/* ****************************************************************** */
+union clause ast = LOADRES : (bool, bool, regidx, word_width, regidx)
+
+mapping clause encdec = LOADRES(aq, rl, rs1, size, rd) if amo_width_valid(size)
+  <-> 0b00010 @ bool_bits(aq) @ bool_bits(rl) @ 0b00000 @ rs1 @ 0b0 @ size_enc(size) @ rd @ 0b0101111 if amo_width_valid(size)
+
+function clause execute(LOADRES(aq, rl, rs1, width, rd)) = {
+  if haveAtomics() then {
+    match ext_data_get_addr(rs1, zeros(), Read(Data), 4) {
+      Ext_DataAddr_Error(e)  => { ext_handle_data_check_error(e); RETIRE_FAIL },
+      Ext_DataAddr_OK(vaddr) =>
+        /* "LR faults like a normal load, even though it's in the AMO major opcode space." */
+        if vaddr[1..0] != 0b00
+        then { handle_mem_exception(vaddr, E_Load_Addr_Align()); RETIRE_FAIL }
+        else match mem_read(Read(Data), vaddr, 4, aq, aq & rl, true) {
+          MemValue(result) => { load_reservation(vaddr); X(rd) = sign_extend(result); RETIRE_SUCCESS },
+          MemException(addr, e) => { handle_mem_exception(addr, e); RETIRE_FAIL }
+        }
+    }
+  } else {
+    handle_illegal();
+    RETIRE_FAIL
+  }
+}
+
+mapping clause assembly = LOADRES(aq, rl, rs1, size, rd)
+  <-> "lr." ^ size_mnemonic(size) ^ maybe_aq(aq) ^ maybe_rl(rl) ^ spc() ^ reg_name(rd) ^ sep() ^ "(" ^ reg_name(rs1) ^ ")"
+
+/* ****************************************************************** */
+union clause ast = STORECON : (bool, bool, regidx, regidx, word_width, regidx)
+
+mapping clause encdec = STORECON(aq, rl, rs2, rs1, size, rd) if amo_width_valid(size)
+  <-> 0b00011 @ bool_bits(aq) @ bool_bits(rl) @ rs2 @ rs1 @ 0b0 @ size_enc(size) @ rd @ 0b0101111 if amo_width_valid(size)
+
+function clause execute (STORECON(aq, rl, rs2, rs1, width, rd)) = {
+  if haveAtomics() then {
+    match ext_data_get_addr(rs1, zeros(), Write(Data), 4) {
+      Ext_DataAddr_Error(e)  => { ext_handle_data_check_error(e); RETIRE_FAIL },
+      Ext_DataAddr_OK(vaddr) =>
+        if vaddr[1..0] != 0b00
+        then { handle_mem_exception(vaddr, E_SAMO_Addr_Align()); RETIRE_FAIL }
+        else if match_reservation(vaddr) == false
+        then { X(rd) = zero_extend(0b1); cancel_reservation(); RETIRE_SUCCESS }
+        else {
+          let rs2_val = X(rs2);
+          match mem_write_value(vaddr, 4, rs2_val[31..0], aq & rl, rl, true) {
+            MemValue(true)  => { X(rd) = zero_extend(0b0); cancel_reservation(); RETIRE_SUCCESS },
+            MemValue(false) => { X(rd) = zero_extend(0b1); cancel_reservation(); RETIRE_SUCCESS },
+            MemException(addr, e) => { handle_mem_exception(addr, e); RETIRE_FAIL }
+          }
+        }
+    }
+  } else {
+    handle_illegal();
+    RETIRE_FAIL
+  }
+}
+
+mapping clause assembly = STORECON(aq, rl, rs2, rs1, size, rd)
+  <-> "sc." ^ size_mnemonic(size) ^ maybe_aq(aq) ^ maybe_rl(rl) ^ spc() ^ reg_name(rd) ^ sep() ^ reg_name(rs2) ^ sep() ^ "(" ^ reg_name(rs1) ^ ")"
+
+/* ****************************************************************** */
+union clause ast = AMO : (amoop, bool, bool, regidx, regidx, word_width, regidx)
+
+mapping encdec_amoop : amoop <-> bits(5) = {
+  AMOSWAP <-> 0b00001,
+  AMOADD  <-> 0b00000,
+  AMOXOR  <-> 0b00100,
+  AMOAND  <-> 0b01100,
+  AMOOR   <-> 0b01000,
+  AMOMIN  <-> 0b10000,
+  AMOMAX  <-> 0b10100,
+  AMOMINU <-> 0b11000,
+  AMOMAXU <-> 0b11100
+}
+
+mapping clause encdec = AMO(op, aq, rl, rs2, rs1, size, rd) if amo_width_valid(size)
+  <-> encdec_amoop(op) @ bool_bits(aq) @ bool_bits(rl) @ rs2 @ rs1 @ 0b0 @ size_enc(size) @ rd @ 0b0101111 if amo_width_valid(size)
+
+function clause execute (AMO(op, aq, rl, rs2, rs1, width, rd)) = {
+  if haveAtomics() then {
+    match ext_data_get_addr(rs1, zeros(), ReadWrite(Data, Data), 4) {
+      Ext_DataAddr_Error(e)  => { ext_handle_data_check_error(e); RETIRE_FAIL },
+      Ext_DataAddr_OK(vaddr) =>
+        if vaddr[1..0] != 0b00
+        then { handle_mem_exception(vaddr, E_SAMO_Addr_Align()); RETIRE_FAIL }
+        else {
+          let rs2_val : xlenbits = X(rs2);
+          match mem_read(ReadWrite(Data, Data), vaddr, 4, aq, aq & rl, true) {
+            MemException(addr, e) => { handle_mem_exception(addr, e); RETIRE_FAIL },
+            MemValue(loaded) => {
+              let result : xlenbits =
+                match op {
+                  AMOSWAP => rs2_val,
+                  AMOADD  => rs2_val + loaded,
+                  AMOXOR  => rs2_val ^ loaded,
+                  AMOAND  => rs2_val & loaded,
+                  AMOOR   => rs2_val | loaded,
+                  AMOMIN  => if rs2_val <_s loaded then rs2_val else loaded,
+                  AMOMAX  => if rs2_val <_s loaded then loaded else rs2_val,
+                  AMOMINU => if rs2_val <_u loaded then rs2_val else loaded,
+                  AMOMAXU => if rs2_val <_u loaded then loaded else rs2_val
+                };
+              match mem_write_value(vaddr, 4, result, aq & rl, rl, true) {
+                MemValue(true)  => { X(rd) = loaded; RETIRE_SUCCESS },
+                MemValue(false) => { internal_error(__FILE__, __LINE__, "AMO got false from mem_write_value") },
+                MemException(addr, e) => { handle_mem_exception(addr, e); RETIRE_FAIL }
+              }
+            }
+          }
+        }
+    }
+  } else {
+    handle_illegal();
+    RETIRE_FAIL
+  }
+}
+
+mapping amo_mnemonic : amoop <-> string = {
+  AMOSWAP <-> "amoswap",
+  AMOADD  <-> "amoadd",
+  AMOXOR  <-> "amoxor",
+  AMOAND  <-> "amoand",
+  AMOOR   <-> "amoor",
+  AMOMIN  <-> "amomin",
+  AMOMAX  <-> "amomax",
+  AMOMINU <-> "amominu",
+  AMOMAXU <-> "amomaxu"
+}
+
+mapping clause assembly = AMO(op, aq, rl, rs2, rs1, width, rd)
+  <-> amo_mnemonic(op) ^ "." ^ size_mnemonic(width) ^ maybe_aq(aq) ^ maybe_rl(rl) ^ spc() ^ reg_name(rd) ^ sep() ^ reg_name(rs2) ^ sep() ^ "(" ^ reg_name(rs1) ^ ")"
