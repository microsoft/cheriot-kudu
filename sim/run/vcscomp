#!/usr/local/bin/bash
#
VlogArg1="+define+CHERIoT"
VlogArg2="+define+KUDU_PPL_CFG=1"
VlogArg3=""
VlogArg4=""
VlogArg5=""
VlogArg6=""
FileList="kudu.vcs.f"
Coverage="false"
OutputDir=""
CmHier="./cm_hier.cfg"

# Loop over args
for arg in "$@"; do
  case "$arg" in
    -conf0) VlogArg2="+define+KUDU_PPL_CFG=0" ;;
    -conf1) VlogArg2="+define+KUDU_PPL_CFG=1" ;;
    -conf2) VlogArg2="+define+KUDU_PPL_CFG=2" ;;
    -conf3) VlogArg2="+define+KUDU_PPL_CFG=3" ;;
    -dw)
      VlogArg3="+define+KUDU_DW_MULT=1"
      FileList="kudu_dw.vcs.f"
      ;;
    -dii)
      VlogArg4="+define+DII_SIM"
      ;;
    -trace_dpi) VlogArg5="+define+TraceDPI" ;;
    -nowave) VlogArg6="+define+NO_FSDB" ;;
    -cov)
     # Code coverage is restricted to the DUT subtree (see ./cm_hier.cfg).
     # Functional coverage (covergroups) is collected regardless.
     Coverage="true"
     ;;
    -outdir=*) OutputDir="${arg#-outdir=}" ;;
    *)
      echo "Warning: Unknown option $arg" >&2
      ;;
  esac
done

VlogArgsRV32="$VlogArg2 $VlogArg3 $VlogArg4 $VlogArg5 $VlogArg6"
VlogArgsCHERI="$VlogArg1 $VlogArg2 $VlogArg3 $VlogArg4 $VlogArg5 $VlogArg6"
#echo "VlogArgs=$VlogArgs  FileList=$FileList"


export rtlRoot=../../rtl
export verifRoot=..
export dwRoot=../../dw

# Resolve inputs before changing directory so every generated file stays in the
# requested output directory, including VCS's implicit logs and coverage files.
CompileRV32=()
CompileCHERI=()
if [[ -n "$OutputDir" ]]; then
  SourceDir="$(pwd -P)"
  export rtlRoot="$SourceDir/../../rtl"
  export verifRoot="$SourceDir/.."
  export dwRoot="$SourceDir/../../dw"
  FileList="$SourceDir/$FileList"
  CmHier="$SourceDir/cm_hier.cfg"
  mkdir -p "$OutputDir" && cd "$OutputDir" || exit "$?"
  CompileRV32=(-Mdir=csrc32 -l compile_rv32.log)
  CompileCHERI=(-Mdir=csrc -l compile_cheriot.log)
fi
InputArgs=(-f "$FileList")
if [[ "$Coverage" == "true" ]]; then
  InputArgs+=(-f "$verifRoot/fcov/kudu_fcov.f"
              -cm line+cond+tgl+fsm+branch+assert -cm_hier "$CmHier")
fi

vcs -full64 -sverilog -xlrm uniq_prior_final +systemverilogext+sv +lint=TFIPC-L -timescale=1ns/1ps -debug_acc+all -o ./simv32 "${CompileRV32[@]}" $VlogArgsRV32 "${InputArgs[@]}" || exit "$?"
vcs -full64 -sverilog -xlrm uniq_prior_final +systemverilogext+sv +lint=TFIPC-L -timescale=1ns/1ps -debug_acc+all -o ./simv "${CompileCHERI[@]}" $VlogArgsCHERI "${InputArgs[@]}"
